<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      The app updates itself: it downloads a release APK and hands it to the system
      installer. Android requires this permission for that, and the user still has to allow
      "install unknown apps" for this app before anything is installed.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The animation preview can hand a generated page to a browser. Since Android 11 an app
      cannot see other installed apps without saying what it looks for, and `resolveActivity`
      would answer null even on a device with three browsers — turning "open in browser" into a
      false "没有找到可以打开网页的应用". This declares only the one intent the app actually
      resolves: viewing an HTML document.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/html" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RelayTester"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RelayTester.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The downloaded APK is handed to the system installer through a content URI: the
          installer runs in another process, and a file:// path across processes has been
          refused since Android 7. The authority is derived from the application id so the
          debug and release builds do not claim the same one.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!--
          A second, separate provider for the animation preview's "在浏览器中打开" action. It
          gets its own authority and its own paths file so the two shares cannot reach each
          other's directories: the installer provider exposes only the downloaded APK, and this
          one only the generated page a browser is asked to open.
        -->
        <provider
            android:name=".core.update.PreviewProvider"
            android:authorities="${applicationId}.previews"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/preview_file_paths" />
        </provider>
    </application>
</manifest>
