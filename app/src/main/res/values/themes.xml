<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RelayTester" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/startup_window_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- API 26–30 fallback: show a themed window instead of an empty preview. -->
    <style name="Theme.RelayTester.Starting" parent="Theme.RelayTester">
    </style>
</resources>
